# ═══════════════════════════════════════════════════════════════════════════
# SALIS AUTO GMS — production environment (docker-compose.prod.yml)
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production        # contains secrets — keep it out of git
#
# This single file serves two purposes:
#   1. Compose interpolation (${DOMAIN}, ${POSTGRES_PASSWORD}) — that's why
#      you MUST pass `--env-file .env.production` on every compose command.
#   2. App runtime env (env_file: .env.production on the app/migrate services).
# ═══════════════════════════════════════════════════════════════════════════

# ═══ REQUIRED — stack ═══
# Bare hostname for Caddy's automatic HTTPS (no scheme, no trailing slash).
# DNS A/AAAA record must point at the VPS BEFORE first start, or Let's
# Encrypt issuance will fail.
# NOTE: salisauto.com currently resolves to 34.111.179.208 (existing hosting).
# Repoint the A record to the VPS IP only at cutover time — see DEPLOYMENT.md §10.1.
DOMAIN=salisauto.com

# Password for the postgres superuser inside the compose network.
# Generate:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# ═══ REQUIRED — app ═══
# Points at the compose `postgres` service (NOT localhost). The password must
# match POSTGRES_PASSWORD above — env files do not interpolate, write it out.
DATABASE_URL=postgresql://postgres:change-me-generate-with-openssl-rand-hex-24@postgres:5432/slis_gms

# Session-cookie signing secret. Generate:  openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

NODE_ENV=production
PORT=5000

# Public URL of the app (callbacks, links in SMS/email).
APP_URL=https://salisauto.com
# Used by the payment layer to build return/webhook URLs.
PUBLIC_APP_URL=https://salisauto.com

# Allowed CORS origin in production (default: same-origin; usually leave unset).
# CORS_ORIGIN=https://salisauto.com

# ═══ OPS — Redis (compose `redis` service) ═══
# Used for multi-process-safe rate limiting and persistent queues.
REDIS_URL=redis://redis:6379

# ═══ OPS — Monitoring (Uptime Kuma, no vars needed) ═══
# The uptime-kuma service is configured entirely through its web UI at
# https://status.salisauto.com (admin account created on first visit — do it
# immediately after `up -d`). Requires a DNS A record for status.salisauto.com
# pointing at the same VPS. Setup walkthrough: DEPLOYMENT.md §10.10.

# ═══ OPS — Backups (scripts/backup-db.sh + optional backup sidecar) ═══
BACKUP_ENABLED=true
# Hour (UTC) the backup sidecar fires; 2 ≈ 05:00 KSA (UTC+3).
BACKUP_HOUR_UTC=2
# Inside the sidecar/postgres container this maps to ./backups on the host.
BACKUP_DIR=/backups
# How many custom-format dumps scripts/backup-db.sh keeps locally.
# BACKUP_KEEP=30
# Retention cohorts used by scripts/backup-pg-dump.mjs (in-app scheduler).
# BACKUP_RETAIN_DAILY=30
# BACKUP_RETAIN_WEEKLY=12
# BACKUP_RETAIN_MONTHLY=12
# Optional off-site copy via AWS CLI; leave unset for local-only backups.
# AWS_S3_BUCKET=gms-backups-bucket-name

# ═══ SAUDI TAX — ZATCA Phase 2 / Fatoora e-invoicing ═══
# Key-deferred: with ZATCA_CSID unset, invoice submission returns a dev stub.
# Sandbox (developer portal):
#   ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal/invoices/clearance/single
# Production (after ZATCA onboarding: CSR → compliance API → production CSID):
#   ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/core/invoices/clearance/single
# ZATCA_API_URL=
# ZATCA_CSID=

# ═══ ERROR TRACKING — Sentry (key-deferred, safe to leave unset) ═══
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ═══ PAYMENTS — Saudi-first, multi-provider (all optional) ═══
# Only gateways with keys set are offered; manual (cash/transfer/cheque)
# is always available.
# PAYMENT_DEFAULT_CURRENCY=SAR
# PAYMENT_GATEWAY_PRIORITY=moyasar,hyperpay,tap,stripe
# -- Moyasar (Mada/cards/Apple Pay/STC Pay) --
# MOYASAR_SECRET_KEY=sk_...
# MOYASAR_WEBHOOK_SECRET=...
# -- HyperPay (MENA) --
# HYPERPAY_ACCESS_TOKEN=...
# HYPERPAY_ENTITY_ID=...
# HYPERPAY_BASE_URL=https://oppwa.com
# -- Tap Payments (MENA) --
# TAP_SECRET_KEY=sk_...
# -- Tabby (BNPL) --
# TABBY_SECRET_KEY=sk_...
# TABBY_MERCHANT_CODE=...
# -- Tamara (BNPL) --
# TAMARA_API_TOKEN=...
# TAMARA_API_URL=https://api.tamara.co
# TAMARA_NOTIFICATION_TOKEN=...
# -- Stripe (international cards + billing) --
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# -- PayPal --
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MODE=live

# ═══ SMS / WHATSAPP — Twilio (optional) ═══
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+966...

# ═══ EMAIL MARKETING — GetResponse (optional) ═══
# GETRESPONSE_API_KEY=...

# ═══ AI — OpenAI-compatible endpoint (optional; stubs when unset) ═══
# OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# ═══ AUTO PARTS — TecDoc (optional) ═══
# TECDOC_API_URL=https://webservice.tecalliance.services/pegasus-3-0/services/TecdocToCatDLB.jsonEndpoint
# TECDOC_API_KEY=...
