# SALIS-GMS environment template. Copy to .env and fill in real values.
# NEVER commit .env — only this example file belongs in git.

# ── Required ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/salis
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PORT=5000

# ── Core behavior ────────────────────────────────────────────────────────
# Cookie Secure flag. true behind HTTPS (production), false for plain-HTTP demos.
SESSION_COOKIE_SECURE=true
# CSRF enforcement override (default: on in production, off in dev/test).
#CSRF_ENFORCE=true
# Per-IP API rate limits per 15 minutes (raise for busy offices behind one NAT IP).
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=10
# Provider trial length in days before paid-tier features lock.
TRIAL_DAYS=14
# Postgres pool size.
#PG_POOL_MAX=10
# Public URL used in emails/links.
#PUBLIC_APP_URL=https://app.example.com
#UPLOAD_DIR=uploads

# ── Demo / development ───────────────────────────────────────────────────
# Seed demo garage + accounts on boot (used by docker-compose demo).
#ALLOW_DEMO_SEED=true
#DEMO_SEED_PASSWORD=Demo123!
#DEMO_MODE=false
# Test-only: never set in production.
#TEST_DATABASE_URL=
#AUTH_BYPASS=

# ── Billing (Stripe) ─────────────────────────────────────────────────────
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_PUBLISHABLE_KEY=pk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...

# ── Saudi payment gateways (each optional; PAYMENT_GATEWAY_PRIORITY orders them)
#PAYMENT_GATEWAY_PRIORITY=moyasar,hyperpay,tap,tamara,tabby
#PAYMENT_DEFAULT_CURRENCY=SAR
#MOYASAR_SECRET_KEY=
#MOYASAR_WEBHOOK_SECRET=
#HYPERPAY_ACCESS_TOKEN=
#HYPERPAY_ENTITY_ID=
#HYPERPAY_BASE_URL=
#TAP_SECRET_KEY=
#TAMARA_API_TOKEN=
#TAMARA_API_URL=
#TABBY_SECRET_KEY=
#TABBY_MERCHANT_CODE=
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#PAYPAL_MODE=sandbox

# ── ZATCA e-invoicing (Phase 2) ──────────────────────────────────────────
# Issued during Fatoora onboarding — see server/scripts/zatca-onboard.ts.
# With these unset the platform stamps phase-1 QRs and stubs clearance.
#ZATCA_EC_PRIVATE_KEY=            # PEM (or base64 of PEM) secp256k1 key
#ZATCA_CERTIFICATE=               # CSID certificate (PEM or base64)
#ZATCA_CSID=                      # binary security token
#ZATCA_SECRET=                    # secret paired with the CSID
# sandbox: .../developer-portal · simulation · production: .../core
#ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
#ZATCA_API_URL=                   # full-URL override (rarely needed)

# ── Government business verification (Wathq) ─────────────────────────────
# With no key, verification runs the deterministic stub (demo identifiers).
#WATHQ_API_KEY=
#WATHQ_API_BASE=
#BUSINESS_VERIFICATION_PROVIDER=

# ── Document OCR (vehicle registration / insurance scans) ────────────────
#GOOGLE_VISION_API_KEY=

# ── Error tracking ───────────────────────────────────────────────────────
#SENTRY_DSN=
#SENTRY_TRACES_SAMPLE_RATE=0.1

# ── SMS / OTP delivery ───────────────────────────────────────────────────
# Unset: OTPs are returned in dev responses instead of sent.
#SMS_PROVIDER=twilio
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_PHONE_NUMBER=

# ── WhatsApp Business webhook ────────────────────────────────────────────
#WHATSAPP_VERIFY_TOKEN=
#WHATSAPP_APP_SECRET=

# ── AI features (optional) ───────────────────────────────────────────────
#OPENAI_API_KEY=
#AI_INTEGRATIONS_OPENAI_API_KEY=
#AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Misc integrations (optional) ─────────────────────────────────────────
#TECDOC_API_KEY=
#TECDOC_API_URL=
#GETRESPONSE_API_KEY=
#GOOGLE_GMB_CLIENT_ID=
#GOOGLE_GMB_CLIENT_SECRET=
#GOOGLE_GMB_ACCESS_TOKEN=
#GOOGLE_GMB_REFRESH_TOKEN=
#BACKUP_ENABLED=false
#BACKUP_HOUR_UTC=2
